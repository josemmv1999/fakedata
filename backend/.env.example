# Clave de API de Anthropic (requerida).
ANTHROPIC_API_KEY=sk-ant-...

# Modelo principal: se usa para el veredicto final (paso más caro y crítico).
MODEL=claude-sonnet-4-6

# Modelo "rápido": se usa para extracción de claims y análisis de lenguaje.
# Haiku es ~10x más barato que Sonnet y suficiente para estos pasos.
FAST_MODEL=claude-haiku-4-5-20251001

# Número máximo de claims que el pipeline extrae y evalúa por ejecución.
MAX_CLAIMS=5

# Caché de resultados completos. Una verificación cacheada se replica al
# instante sin gastar tokens. La clave es (hash(input), locale).
CACHE_ENABLED=true
CACHE_DB_PATH=cache.db
# Tiempo de vida de cada entrada en horas. 168 = 7 días. Pasado el TTL la
# entrada se trata como miss y se vuelve a verificar.
CACHE_TTL_HOURS=168
