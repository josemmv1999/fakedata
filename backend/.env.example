# Switch between "anthropic" and "ollama"
LLM_PROVIDER=anthropic

# Anthropic settings
ANTHROPIC_API_KEY=your-real-key-here

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models — each provider uses its own pair
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

OLLAMA_MODEL=hf.co/bartowski/Qwen_Qwen3-14B-GGUF:Q4_K_M
OLLAMA_FAST_MODEL=hf.co/bartowski/Qwen_Qwen3-14B-GGUF:Q4_K_M

# Número máximo de claims que el pipeline extrae y evalúa por ejecución.
MAX_CLAIMS=5

# Caché de resultados completos. Una verificación cacheada se replica al
# instante sin gastar tokens. La clave es (hash(input), locale).
CACHE_ENABLED=true
CACHE_DB_PATH=cache.db
# Tiempo de vida de cada entrada en horas. 168 = 7 días. Pasado el TTL la
# entrada se trata como miss y se vuelve a verificar.
CACHE_TTL_HOURS=168
